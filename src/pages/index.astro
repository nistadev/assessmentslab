---
import { getCollection } from 'astro:content';
import FooterBar from '../components/FooterBar.astro';
import HomePage from '../components/HomePage';
import ServiceWorkerCleanup from '../components/shared/ServiceWorkerCleanup.astro';
import '../styles/global.css';

const entries = await getCollection('questions');
const studyEntries = await getCollection('study');

const questions = entries.flatMap(entry =>
  entry.data.questions.map((q, index) => ({
    ...q,
    questionId: `${entry.id}:${index}`,
    domains: q.domains ?? entry.data.defaultDomains,
    topics: q.topics ?? entry.data.defaultTopics,
  }))
);

const studyLessons = studyEntries
  .sort((a, b) => a.id.localeCompare(b.id))
  .flatMap(entry =>
    entry.data.lessons.map((lesson, index) => ({
      ...lesson,
      lessonId: `${entry.id}:${index}`,
      domains: lesson.domains ?? entry.data.defaultDomains,
      topics: lesson.topics ?? entry.data.defaultTopics,
    }))
  );
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0b1020" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon.svg" />
    <title>assessmentslab</title>
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const legacyTheme = storedTheme === 'dark' ? 'dark' : storedTheme;
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const theme = legacyTheme === 'light' || legacyTheme === 'dark' ? legacyTheme : systemTheme;
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body class="min-h-screen bg-base-100">
    <ServiceWorkerCleanup />
    <HomePage questions={questions} studyLessons={studyLessons} client:load />
    <FooterBar />
  </body>
</html>
