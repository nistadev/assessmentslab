---
import FooterBar from '../components/FooterBar.astro';
import ResultsPage from '../components/ResultsPage';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AssesLab Results</title>
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const legacyTheme = storedTheme === 'dark' ? 'dark' : storedTheme;
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const theme = legacyTheme === 'light' || legacyTheme === 'dark' ? legacyTheme : systemTheme;
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body class="min-h-screen bg-base-100">
    <ResultsPage client:load />
    <FooterBar />
  </body>
</html>
