---
import FooterBar from '../components/FooterBar.astro';
import SettingsPage from '../components/SettingsPage';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0b1020" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon.svg" />
    <title>Settings | assessmentslab</title>
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const legacyTheme = storedTheme === 'dark' ? 'dark' : storedTheme;
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const theme = legacyTheme === 'light' || legacyTheme === 'dark' ? legacyTheme : systemTheme;
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body class="min-h-screen bg-base-100">
    <SettingsPage client:load />
    <FooterBar />
  </body>
</html>
