---
import { getCollection } from 'astro:content';
import FooterBar from '../components/FooterBar.astro';
import StudyPage from '../components/StudyPage';
import '../styles/global.css';

const entries = await getCollection('study');
const questionEntries = await getCollection('questions');

const lessons = entries
  .sort((a, b) => a.id.localeCompare(b.id))
  .flatMap(entry =>
    entry.data.lessons.map((lesson, index) => ({
      ...lesson,
      lessonId: `${entry.id}:${index}`,
      domains: lesson.domains ?? entry.data.defaultDomains,
      topics: lesson.topics ?? entry.data.defaultTopics,
    }))
  );

const questions = questionEntries.flatMap(entry =>
  entry.data.questions.map((q, index) => ({
    ...q,
    questionId: `${entry.id}:${index}`,
    domains: q.domains ?? entry.data.defaultDomains,
    topics: q.topics ?? entry.data.defaultTopics,
  }))
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0b1020" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon.svg" />
    <title>Study | assessmentslab</title>
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const legacyTheme = storedTheme === 'dark' ? 'dark' : storedTheme;
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const theme = legacyTheme === 'light' || legacyTheme === 'dark' ? legacyTheme : systemTheme;
      document.documentElement.dataset.theme = theme;
      document.documentElement.dataset.appMode = 'study';
    </script>
  </head>
  <body class="min-h-screen bg-base-100">
    <StudyPage lessons={lessons} questions={questions} client:load />
    <FooterBar />
  </body>
</html>
