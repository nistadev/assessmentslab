---
const repoUrl = 'https://github.com/nistadev/assessmentslab';
---

<footer class="px-4 pb-8 pt-4">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-2 text-center text-sm text-base-content/55">
    <p>
      build with agents 🤖 by
      <a
        href="https://github.com/nistadev"
        target="_blank"
        rel="noreferrer"
        class="ml-1 font-medium text-primary underline underline-offset-4"
      >
        nistadev
      </a>
    </p>
    <p>
      <a
        href={repoUrl}
        target="_blank"
        rel="noreferrer"
        class="font-medium text-primary underline underline-offset-4"
      >
        ⭐️ Star on GitHub
      </a>
      <span class="mx-2 text-base-content/35">•</span>
      <a
        href={repoUrl}
        target="_blank"
        rel="noreferrer"
        class="font-medium text-primary underline underline-offset-4"
      >
        ✍️ Contribute
      </a>
    </p>
  </div>
</footer>
